# Database Configuration
MONGODB_URI=mongodb://admin:admin123@mongodb:27017/pet_management?authSource=admin
MONGO_ROOT_USERNAME=admin
MONGO_ROOT_PASSWORD=admin123
MONGO_DATABASE=pet_management

# Server Configuration
PORT=5001
NODE_ENV=development

# Public URL of the web frontend (used in pet QR codes and email links)
FRONTEND_URL=http://localhost:3000

# Browser origins allowed to call the API (comma separated)
CORS_ORIGINS=http://localhost:3000,https://lively-sky-055ae2000.7.azurestaticapps.net

# JWT Configuration
JWT_SECRET=dev-jwt-secret-key-change-in-production

# Admin User Configuration
ADMIN_EMAIL=admin@petmanagement.com
ADMIN_PASSWORD=Admin@123

# Who is emailed about urgent/emergency animal incident reports (comma separated).
# If empty, all administrator accounts are emailed.
AUTHORITY_ALERT_EMAILS=

# Email via Azure Communication Services (used in production; takes priority over SMTP)
# ACS_EMAIL_CONNECTION_STRING=endpoint=https://<resource>.communication.azure.com/;accesskey=<key>
# ACS_EMAIL_SENDER=DoNotReply@<azure-managed-domain>.azurecomm.net

# Email Configuration (SMTP)
# For Gmail: smtp.gmail.com, Port: 587
# For Outlook: smtp.office365.com, Port: 587
# If SMTP_HOST/SMTP_USER are empty, emails are only logged and reminders are NOT marked as sent
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=Pet Management System <noreply@petmanagement.com>

# Vaccination Scheduler Configuration
# Cron expression for daily reminder check (default: 9 AM daily)
# Format: minute hour day month dayOfWeek
# Examples:
#   0 9 * * * = Every day at 9:00 AM
#   0 8,12,18 * * * = Every day at 8 AM, 12 PM, and 6 PM
#   */30 * * * * = Every 30 minutes
REMINDER_CRON=0 9 * * *

# SMS Configuration (Optional - for future Twilio integration)
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_PHONE_NUMBER=
