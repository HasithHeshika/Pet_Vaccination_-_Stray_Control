{
  "name": "pet-management-backend",
  "version": "1.0.0",
  "description": "Backend for Pet Ownership, Vaccination & Stray Control System",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "regenerate-qr": "node scripts/regenerate-qr-codes.js",
    "test": "node --test --test-concurrency=1 tests/unit.test.js tests/api.test.js",
    "test:unit": "node --test tests/unit.test.js",
    "test:coverage": "c8 --temp-directory=.c8tmp --clean --exclude=tests/** --exclude=scripts/** --exclude=coverage/** --reporter=text --reporter=json-summary --reporter=html npm test"
  },
  "keywords": [
    "pet",
    "management",
    "vaccination",
    "MERN"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-validator": "^7.3.0",
    "jose": "^5.9.6",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.0.3",
    "multer": "^2.0.2",
    "node-cron": "^4.6.0",
    "nodemailer": "^10.2.1",
    "qrcode": "^1.5.3",
    "sharp": "^0.34.2"
  },
  "devDependencies": {
    "c8": "^10.1.3",
    "nodemon": "^3.0.2"
  }
}
